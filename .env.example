# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
# Leave empty or set to "memory" to use embedded MongoDB in local development/testing
MONGODB_URI=

# Security & JWT Secrets (Replace with strong random strings in production)
JWT_ACCESS_SECRET=access_secret_bail_reckoner_bnss_2023_secure_key_12345
JWT_REFRESH_SECRET=refresh_secret_bail_reckoner_bnss_2023_secure_key_67890

# Seed Admin Credentials (Will be forced to change password on first login)
ADMIN_EMAIL=admin@bailreckoner.gov.in
ADMIN_PASSWORD=Admin@Initial123

# Email SMTP Settings (Gmail App Password, Brevo, Resend SMTP)
# By default, logs to console and EmailLog collection if credentials are empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bail Reckoner TN" <support@bailreckoner.gov.in>

# Storage Configuration: "local" or "cloudinary"
STORAGE_TYPE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
